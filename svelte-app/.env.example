# Used by the Vite app (browser). Set the same keys in Netlify → Site configuration → Environment variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Local seed script only (npm run seed:supabase). Never commit real values. Never expose service_role to the frontend or Netlify "client" env.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
